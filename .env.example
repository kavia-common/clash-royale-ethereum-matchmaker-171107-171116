# Core
NODE_ENV=development
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/matchmaker

# Auth
SESSION_SECRET=change_me
AUTH_NONCE_TTL_SECONDS=300

# Clash Royale
CR_API_BASE=https://api.clashroyale.com/v1
CR_API_TOKEN=replace_with_supercell_token
CR_LINK_TOKEN_TTL_SECONDS=600

# Chain
CHAIN_ID=8453
RPC_URL=https://replace-with-rpc
ESCROW_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
CONFIRMATIONS=2

# Indexer/Jobs
INDEXER_POLL_MS=4000

# Optional
REDIS_URL=redis://redis:6379
LOG_LEVEL=info
