# Environment variables for Clash Royale Ethereum Matchmaker (Frontend)
# Copy this file to ".env" and adjust values for your environment.
# Note: All variables must be prefixed with REACT_APP_ to be accessible in the browser build.

# Base URL for the backend API
# If omitted, the app will use deterministic mock API data for development and show a 'Mock API mode' banner.
# Example: http://localhost:8000 or https://api.example.com
# REACT_APP_API_URL=http://localhost:8000

# Escrow contract address (Ethereum)
# Example (dummy): 0x0000000000000000000000000000000000000000
REACT_APP_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# Ethereum Chain ID used by the dApp
# Common values:
# - 1 (Ethereum Mainnet)
# - 5 (Goerli testnet)
# - 11155111 (Sepolia)
# - 137 (Polygon Mainnet)
# - 80001 (Polygon Mumbai)
REACT_APP_CHAIN_ID=11155111

# Base URL for block explorer links for the configured chain
# Examples:
# - https://etherscan.io (Mainnet)
# - https://goerli.etherscan.io (Goerli)
# - https://sepolia.etherscan.io (Sepolia)
# - https://polygonscan.com (Polygon)
# - https://mumbai.polygonscan.com (Polygon Mumbai)
REACT_APP_BLOCK_EXPLORER_BASE=https://sepolia.etherscan.io

# Dry-run escrow mode: simulate deposit flow without sending a real transaction.
# Set to "true" to enable; any other value disables.
REACT_APP_DRY_RUN_ESCROW=true
