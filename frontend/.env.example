# API (leave empty to enable mock mode)
# When empty, the app uses built-in mocked data for development and shows a non-blocking "Mock API mode" banner.
REACT_APP_API_URL=

# Blockchain/Escrow configuration
# Example: 11155111 for Sepolia
REACT_APP_CHAIN_ID=11155111

# Optional block explorer base, e.g., https://sepolia.etherscan.io/tx/
# If provided, transaction links will be rendered using this base.
REACT_APP_BLOCK_EXPLORER_BASE=

# Escrow contract address (leave empty for dry-run)
# If empty, the app enters "dry-run" escrow mode and simulates deposits without sending transactions.
REACT_APP_ESCROW_ADDRESS=

# Enable dry-run escrow logic (true/false). Default true when address is missing.
# If set to "true", deposit flows are simulated even if an address is provided.
REACT_APP_DRY_RUN_ESCROW=true
