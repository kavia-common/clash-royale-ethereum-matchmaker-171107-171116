# Frontend environment variables
# Copy this file to .env and adjust values per environment.

# Backend base URL. If omitted, the app runs in Mock API mode.
# Example: https://api.staging.example.com
REACT_APP_API_URL=

# When true, simulate escrow deposits and confirmations without hitting the blockchain.
# Dry-run is also enabled automatically if REACT_APP_ESCROW_ADDRESS is not set.
# Values: "true" or "false"
REACT_APP_DRY_RUN_ESCROW=true

# Escrow smart contract address for real deposits.
# Leave empty for preview/dry-run.
REACT_APP_ESCROW_ADDRESS=

# Target chain ID for the dapp.
# Default used in code is 11155111 (Sepolia). Ensure MetaMask is on this network.
REACT_APP_CHAIN_ID=11155111
